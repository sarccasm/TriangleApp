@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Invalid Triangle</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
        }
        .error-box {
            background: white;
            padding: 32px 40px;
            border-radius: 12px;
            box-shadow: 0 8px 30px rgba(0,0,0,.12);
            text-align: center;
            max-width: 520px;
        }
        h1 { margin-top: 0; }
    </style>
</head>
<body>
    <div class="error-box">
        <h1>Invalid Triangle</h1>
        <p>The supplied side lengths cannot form a valid triangle.</p>
    </div>
</body>
</html>
